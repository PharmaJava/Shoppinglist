# Copia este archivo a .env.local y rellena los valores.
# .env.local nunca se commitea (ver .gitignore).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio. En producción: https://listasupermercado.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (F1-1, protección del alta anónima) — opcional en desarrollo
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Notificaciones push (opcional). Sin estas variables el interruptor no aparece
# y el endpoint de envío responde 404. Genera el par con:
#   pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secreto compartido con el Database Webhook de Supabase (cabecera x-webhook-secret)
PUSH_WEBHOOK_SECRET=
# Sólo en el servidor. Nunca en el navegador: se salta RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Panel de administración (/vegeta) ───────────────────────────────
# Sin estas dos variables la ruta existe pero no deja entrar a nadie.
# El hash se genera con `pnpm admin:hash` y NO es la contraseña: la
# contraseña en claro no se guarda en ningún sitio. Cambiar el hash cierra
# todas las sesiones abiertas del panel.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# El panel además necesita SUPABASE_SERVICE_ROLE_KEY (arriba): sin ella sólo
# vería las listas del propio administrador, que son ninguna.

# ─── Fase 3 (premium) ────────────────────────────────────────────────
# Todo lo de pago vive detrás de este interruptor y **por defecto está
# apagado**: el código está en el repositorio pero no hay puerta por la que
# entrar. Se enciende con 1 o true, y sólo cuando la fase esté terminada.
# Ver docs/11-FASE3.md.
NEXT_PUBLIC_FEATURE_PREMIUM=
# Listas automáticas: secreto de la tarea programada diaria. En Vercel se pone
# como variable de entorno y Vercel la manda sola en la cabecera Authorization
# al llamar a /api/cron/recurring; sin ella esa ruta responde 404.
# Ver docs/13-RECURRENTES.md.
CRON_SECRET=
