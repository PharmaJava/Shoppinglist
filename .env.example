# Copia este archivo a .env.local y rellena los valores.
# .env.local nunca se commitea (ver .gitignore).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (dominio aún por decidir — ver docs/00-PLAN.md §10)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (F1-1, protección del alta anónima) — opcional en desarrollo
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog (EU Cloud) — sin esto, la analítica simplemente no se activa (no-op)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry — sin esto, no se reportan errores (no-op). SENTRY_ORG/PROJECT/AUTH_TOKEN
# sólo hacen falta en el entorno de build (Vercel) para subir source maps;
# sin ellos el build funciona igual, sólo con stack traces minificados.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
