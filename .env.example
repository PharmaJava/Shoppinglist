# Copia este archivo a .env.local y rellena los valores.
# .env.local nunca se commitea (ver .gitignore).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio. En producción: https://listasupermercado.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (F1-1, protección del alta anónima) — opcional en desarrollo
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Notificaciones push (opcional). Sin estas variables el interruptor no aparece
# y el endpoint de envío responde 404. Genera el par con:
#   pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secreto compartido con el Database Webhook de Supabase (cabecera x-webhook-secret)
PUSH_WEBHOOK_SECRET=
# Sólo en el servidor. Nunca en el navegador: se salta RLS.
SUPABASE_SERVICE_ROLE_KEY=
